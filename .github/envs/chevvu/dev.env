# Langfuse non-sensitive environment file for chevvu/dev
# Keep credentials out of this file. All secrets are injected via AWS Secrets Manager
# Leave sensitive values EMPTY - they will be injected from GitHub Secrets

# General Configuration
NEXTAUTH_URL=https://langfuse-dev.your-domain.com
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# Security - INJECTED FROM AWS SECRETS MANAGER (leave empty)
DATABASE_URL=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ClickHouse Configuration
# Update these with your actual ClickHouse service endpoints
CLICKHOUSE_MIGRATION_URL=clickhouse://dev-clickhouse.langfuse.internal:9000
CLICKHOUSE_URL=http://dev-clickhouse.langfuse.internal:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CLUSTER_ENABLED=false

# S3/MinIO Configuration
# Update endpoints with your actual MinIO/S3 service URLs
LANGFUSE_USE_AZURE_BLOB=false

# Event Upload
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://dev-minio.langfuse.internal:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

# Media Upload
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://dev-minio.langfuse.internal:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# Batch Export
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-exports
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=us-east-1
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://dev-minio.langfuse.internal:9000
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=https://minio-dev.your-domain.com
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

# Ingestion tuning (optional)
LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

# Performance Tuning (Optional)
LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

# Redis Configuration
# Update with your actual Redis service endpoint
REDIS_HOST=dev-redis.langfuse.internal
REDIS_PORT=6379
REDIS_AUTH=
REDIS_TLS_ENABLED=false

# Email/SMTP (Optional)
EMAIL_FROM_ADDRESS=noreply@your-domain.com
SMTP_CONNECTION_URL=

# Application Initialization (Optional - for first-time setup only)
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=